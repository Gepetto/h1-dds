sdf_path := "../gz_gepetto_humanoids_models/h1_2/h1_2.sdf"

install:
    #!/usr/bin/env bash
    cd build
    cmake ..
    make && sudo cp libgz-unitree.so /usr/local/lib/gz-unitree/

sim:
    echo Dont forget to add plugin filename="gz-unitree" name="gz::unitree::UnitreePlugin" to your SDF file, in the model tag
    just multicast lo
    just install && GZ_SIM_SYSTEM_PLUGIN_PATH=/usr/local/lib/gz-unitree/ gz sim {{sdf_path}} -v | rg --fixed-strings '[Unitree]'
    # GZ_SIM_SYSTEM_PLUGIN_PATH=/usr/local/lib/gz-unitree/ gz sim {{sdf_path}} -v 4
    # gz sim {{sdf_path}} -v 4
test:
    #!/usr/bin/env bash
    just multicast lo
    cd ../unitree_sdk2
    mkdir -p build
    cd build
    cmake ..
    make h1_27dof_example
    echo Starting h1_27dof_example...
    sudo bin/h1_27dof_example lo
    echo Done

multicast iface="lo":
    sudo route add -net 224.0.0.0 netmask 240.0.0.0 dev {{iface}} || echo "Multicast route already exists"
    sudo ifconfig {{iface}} multicast
